# App auth & router settings
AUTH_COOKIE_NAME=fueled_access_session
AUTH_JWT_SECRET=PLEASE_CHANGE_THIS_IN_PRODUCTION
FRONTEND_ORIGIN=http://localhost:5173
SSO_PROXY_URL=https://ssoproxy.10uplabs.com/wp-login.php
AUTH_CALLBACK_URL=http://localhost:3003/auth/callback

# Supabase (scanner server only — dashboard talks to Express, not Supabase directly)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Publishable (anon) key — use for SUPABASE_KEY when using RLS + Supabase Auth sessions
SUPABASE_KEY=sb_publishable_YOUR_KEY
#
# Secret API key (sb_secret_…) — server-only. After SSO, used to mint Supabase Auth sessions
# (admin generateLink). Never expose to the browser. Not the same as a JWT “signing secret”.
# When set with SUPABASE_URL + SUPABASE_KEY, access tokens are ES256 and verified via JWKS:
# https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY
